DATABASE_URL="postgresql://suzume:suzume@localhost:5432/suzume?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Optional. Defaults to "console", which logs password-reset links to the
# server console instead of emailing them — fine for local development.
# Set to a real provider once one is wired up in email.provider.ts.
EMAIL_PROVIDER=console

# Optional. Defaults to "mock", a deterministic local parser for the
# Paste/Extract feature. See extraction.provider.ts.
EXTRACTION_PROVIDER=mock
