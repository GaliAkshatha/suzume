# Leave unset for local development — vite.config.ts proxies /api to
# http://localhost:4000 automatically.
#
# Set this in production when the frontend and backend are deployed to
# different domains (e.g. frontend on Vercel, API on Render):
# VITE_API_BASE_URL="https://suzume-api.onrender.com/api"
VITE_API_BASE_URL=
